# EchoKey API endpoint
ECHOKEY_API_URL=https://echokey-dev.localhost:8443

# Optional PEM CA bundle for a locally trusted/private API certificate.
# ECHOKEY_CA_CERT=/absolute/path/to/rootCA.pem

# Global hotkey. Hold to record, release to stop.
# Examples: f12, <ctrl>+<shift>+r, <cmd>+z (cmd/super/win are aliases)
HOTKEY=f4

DEBUG=false
